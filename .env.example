# ───── MAVRIX FIRE — server configuration (copy to .env locally; set as host env vars in production) ─────
NODE_ENV=production
PORT=8080
PUBLIC_URL=https://app.yourdomain.com          # public https URL of this service
CORS_ORIGINS=https://localhost                 # comma-separated; "https://localhost" is the Android (Capacitor) app origin
TRUST_PROXY=true

# ── Database: PostgreSQL (Supabase / Neon / RDS …). Use the *pooled* or direct connection string.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_SSL=true

# ── One-time First Admin Setup is locked behind this secret. Generate: openssl rand -base64 32
# After the admin account exists, setup is permanently closed (enforced by a database constraint).
ADMIN_SETUP_TOKEN=
ADMIN_IDLE_MINUTES=30
ADMIN_MAX_SESSION_HOURS=12

# ── Payments: Razorpay (Orders + Route for seller split settlement). Use rzp_test_* keys until live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=                       # set the same value in Razorpay Dashboard → Webhooks

# ── Image storage: any S3-compatible bucket (Cloudflare R2, Supabase Storage S3, AWS S3)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=                                   # blank for AWS S3; e.g. https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=                            # public/CDN URL of the bucket, e.g. https://cdn.yourdomain.com

# ── Optional sign-in methods (each is hidden/disabled until configured)
GOOGLE_CLIENT_ID=                              # Google Cloud OAuth "Web" client ID
MSG91_AUTH_KEY=                                # SMS OTP via MSG91 (DLT-registered template required in India)
MSG91_TEMPLATE_ID=
